{
	"name": "taro-vue3-ts",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@10.33.3",
	"description": "taro-vue3-ts",
	"templateInfo": {
		"name": "vue3-pinia",
		"typescript": true,
		"css": "less"
	},
	"scripts": {
		"dev:weapp": "pnpm run build:weapp -- --watch",
		"build-watch:weapp": "taro build --type weapp --watch --env production",
